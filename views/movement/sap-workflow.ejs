<%
const steps = [
  { code: 'VL01N', name: 'Create outbound delivery', detail: 'Create delivery with reference to the sales order', field: 'sapDeliveryNumber' },
  { code: 'VL02N', name: 'Picking & delivery details', detail: 'Picking quantity, vehicle and transport details', field: 'sapDeliveryNumber' },
  { code: 'PGI', name: 'Post goods issue', detail: 'Goods issue after dispatch confirmation', field: 'sapDeliveryNumber' },
  { code: 'VF01', name: 'Create billing document', detail: 'Create invoice from the eligible reference document', field: 'sapBillingNumber' },
  { code: 'DS', name: 'Digital signature', detail: 'Generate / apply the authorised digital signature', field: 'signedPdf' },
  { code: 'ATT', name: 'Add signed attachment', detail: 'Attach the signed PDF to the SAP billing document', field: 'signedAttachment' },
  { code: 'ASN', name: 'Generate ASN', detail: 'Generate and verify the advance shipping notice', field: 'asnNumber' },
];
const done = (field) => field === 'sapDeliveryNumber' ? Boolean(ticket.sapDeliveryNumber) : field === 'sapBillingNumber' ? Boolean(ticket.sapBillingNumber) : false;
const printCount = ticket.printCount || 0;
%>
<div class="d-flex justify-content-between align-items-center mb-4 no-print">
  <div><h4 class="mb-1">Dispatch & invoice workflow</h4><p class="text-muted mb-0"><%= ticket.ticketNumber %> · automatic status tracking</p></div>
  <div class="d-flex gap-2"><a href="/movement-tickets/<%= ticket.id %>" class="btn btn-light">Back to ticket</a><a href="/movement-tickets" class="btn btn-light">All tickets</a></div>
</div>
<div class="alert alert-info no-print">This page tracks the SAP process for each part. No SAP document numbers are entered here. Statuses are shown only when the corresponding document reference is saved and verified. Sandbox sample data is not linked to this movement ticket.</div>

<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Movement ticket</div><h5 class="mb-1"><%= ticket.ticketNumber %></h5><span class="badge bg-secondary"><%= ticket.status %></span></div></div></div>
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Sales order</div><h5 class="mb-1"><%= ticket.salesOrder || 'Not linked' %></h5><small class="text-muted">From saved ticket data</small></div></div></div>
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Outbound delivery</div><h5 class="mb-1"><%= ticket.sapDeliveryNumber || 'Pending' %></h5><small class="text-muted">VL01N</small></div></div></div>
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Billing document</div><h5 class="mb-1"><%= ticket.sapBillingNumber || 'Pending' %></h5><small class="text-muted">VF01</small></div></div></div>
</div>

<div class="card mb-4">
 <div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0">Part-wise workflow</h5><span class="text-muted small"><%= ticket.items.length %> part(s)</span></div>
 <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Part</th><th>Sales order</th><th class="text-end">Quantity</th><th>Delivery</th><th>Invoice</th><th>Overall status</th></tr></thead><tbody>
 <% ticket.items.forEach((item) => { %>
 <tr><td><strong><%= item.productCode %></strong><div class="small text-muted"><%= item.partName %></div></td><td><%= item.salesOrder || ticket.salesOrder || '—' %></td><td class="text-end"><%= item.quantity %> <%= item.unit %></td><td><% if(ticket.sapDeliveryNumber){ %><span class="badge bg-success">Created</span><% } else { %><span class="badge bg-secondary">Pending</span><% } %></td><td><% if(ticket.sapBillingNumber){ %><span class="badge bg-success">Created</span><% } else { %><span class="badge bg-secondary">Pending</span><% } %></td><td><span class="badge bg-warning text-dark">In progress</span></td></tr>
 <% }) %>
 </tbody></table></div>
</div>

<div class="card mb-4">
 <div class="card-header"><h5 class="mb-0">SAP transaction timeline</h5></div>
 <div class="card-body"><div class="list-group list-group-flush">
 <% steps.forEach((step, index) => { const completed = done(step.field); %>
 <div class="list-group-item px-0 d-flex align-items-start gap-3">
   <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 <%= completed ? 'bg-success' : 'bg-light border' %>" style="width:36px;height:36px"><% if(completed){ %><i class="ri-check-line text-white"></i><% } else { %><span class="small fw-semibold"><%= index+1 %></span><% } %></div>
   <div class="flex-grow-1"><div class="d-flex flex-wrap align-items-center gap-2"><strong><%= step.name %></strong><span class="badge bg-light text-dark border"><%= step.code %></span><% if(completed){ %><span class="badge bg-success">Reference available</span><% } else { %><span class="badge bg-secondary">Awaiting integration</span><% } %></div><div class="small text-muted mt-1"><%= step.detail %></div></div>
 </div>
 <% }) %>
 </div></div>
</div>

<div class="card mb-4">
 <div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0">Generated documents & signed attachments</h5><span class="badge bg-secondary">0 verified files</span></div>
 <div class="card-body"><div class="text-muted">No signed PDF or ASN attachment has been verified for this ticket yet. When SAP returns the generated files, they will appear here with document name, type, creation status and a preview link.</div></div>
</div>

<div class="card">
 <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div><h5 class="mb-1">Print documents</h5><div class="text-muted small">Print the current workflow summary. SAP PDFs will be included here once their attachment download integration is verified.</div><div class="small mt-1">Print initiated count: <strong id="printCount"><%= printCount %></strong></div></div>
  <button id="printWorkflowButton" class="btn btn-primary no-print" onclick="printWorkflow(<%= ticket.id %>)"><i class="ri-printer-line me-1"></i>Print workflow summary</button>
 </div>
</div>
<style>
@media print { .no-print, nav, aside, .sidebar { display:none!important } body { background:#fff!important } .card { break-inside:avoid; box-shadow:none!important } }
</style>
<script>
async function printWorkflow(ticketId) {
  const button = document.getElementById("printWorkflowButton");
  button.disabled = true;
  try {
    const response = await fetch(`/api/movement-tickets/${ticketId}/print`, { method: "POST", headers: { Accept: "application/json" } });
    if (!response.ok) throw new Error("Could not record print action");
    const result = await response.json();
    document.getElementById("printCount").textContent = result.printCount;
    window.print();
  } catch (error) {
    alert(error.message || "Print action failed");
  } finally { button.disabled = false; }
}
</script>
