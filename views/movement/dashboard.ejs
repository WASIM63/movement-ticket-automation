<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h4 class="mb-1">Movement Dashboard</h4><p class="text-muted mb-0">Dispatch and invoice workflow</p></div>
    <a href="/movement-tickets/new" class="btn btn-primary"><i class="ri-add-line me-1"></i>Create Movement Ticket</a>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card card-animate"><div class="card-body"><p class="text-muted mb-1">Total tickets</p><h3><%= stats.tickets %></h3></div></div></div>
    <div class="col-md-4"><div class="card card-animate"><div class="card-body"><p class="text-muted mb-1">Draft / awaiting SAP</p><h3><%= stats.draft %></h3></div></div></div>
    <div class="col-md-4"><div class="card card-animate"><div class="card-body"><p class="text-muted mb-1">SAP completed</p><h3><%= stats.completed %></h3></div></div></div>
  </div>
  <div class="card"><div class="card-header d-flex justify-content-between"><h5 class="card-title mb-0">Workflow</h5><a href="/movement-tickets" class="btn btn-sm btn-soft-primary">View tickets</a></div>
    <div class="card-body"><div class="row text-center g-3">
      <div class="col-md-3"><i class="ri-file-edit-line fs-1 text-primary"></i><h6>1. Create memo</h6><small class="text-muted">Vehicle, order, parts and quantities</small></div>
      <div class="col-md-3"><i class="ri-checkbox-circle-line fs-1 text-primary"></i><h6>2. Review</h6><small class="text-muted">Validate all selected data</small></div>
      <div class="col-md-3"><i class="ri-cloud-line fs-1 text-primary"></i><h6>3. SAP processing</h6><small class="text-muted">Enabled after API mapping and approval</small></div>
      <div class="col-md-3"><i class="ri-printer-line fs-1 text-primary"></i><h6>4. Print</h6><small class="text-muted">Movement memo and SAP invoice</small></div>
    </div></div>
  </div>
</div>
