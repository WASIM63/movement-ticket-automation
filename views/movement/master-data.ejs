<div class="d-flex justify-content-between align-items-center mb-4"><div><h4 class="mb-1">Master Data</h4><p class="text-muted mb-0">Maintain dropdown values used by the movement memo.</p></div><a href="/movement-tickets/new" class="btn btn-primary">Create ticket</a></div>
<div class="alert alert-info">Only enter verified company master data. This starter does not guess the remaining rows from the photographed paper list.</div>
<div class="row g-3">
<div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">Add plant</h5></div><div class="card-body"><form id="plantForm"><div class="mb-3"><label class="form-label">Plant code</label><input class="form-control" name="code" required></div><div class="mb-3"><label class="form-label">Plant name</label><input class="form-control" name="name" required></div><button class="btn btn-primary">Save plant</button></form></div></div></div>
<div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">Add vehicle</h5></div><div class="card-body"><form id="vehicleForm"><div class="mb-3"><label class="form-label">Registration number</label><input class="form-control" name="registration" placeholder="GJ01KT4011" required></div><div class="mb-3"><label class="form-label">Description</label><input class="form-control" name="description"></div><button class="btn btn-primary">Save vehicle</button></form></div></div></div>
<div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">Add part</h5></div><div class="card-body"><form id="partForm"><div class="mb-2"><label class="form-label">Product code</label><input class="form-control" name="productCode" required></div><div class="mb-2"><label class="form-label">Part name</label><input class="form-control" name="partName" required></div><div class="mb-2"><label class="form-label">Customer reference</label><input class="form-control" name="customerReference"></div><div class="mb-2"><label class="form-label">Sales order</label><input class="form-control" name="salesOrder"></div><div class="mb-2"><label class="form-label">Sub M</label><input class="form-control" name="subM"></div><div class="mb-3"><label class="form-label">Unit</label><input class="form-control" name="unit" value="EA"></div><button class="btn btn-primary">Save part</button></form></div></div></div>
</div>
<div class="card mt-3"><div class="card-body"><h5>Current records</h5><div class="row"><div class="col-md-4"><h6>Plants (<%= plants.length %>)</h6><ul class="small"><% plants.forEach(x=>{ %><li><%= x.code %> — <%= x.name %></li><% }) %></ul></div><div class="col-md-4"><h6>Vehicles (<%= vehicles.length %>)</h6><ul class="small"><% vehicles.forEach(x=>{ %><li><%= x.registration %></li><% }) %></ul></div><div class="col-md-4"><h6>Parts (<%= parts.length %>)</h6><ul class="small"><% parts.slice(0,30).forEach(x=>{ %><li><%= x.productCode %> — <%= x.partName %></li><% }) %></ul></div></div></div></div>
<script>
async function bindForm(id,url){document.getElementById(id).addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget).entries());try{const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const b=await r.json();if(!r.ok)throw new Error(b.message||'Save failed');location.reload();}catch(err){alert(err.message);}});}
bindForm('plantForm','/api/master-data/plants');bindForm('vehicleForm','/api/master-data/vehicles');bindForm('partForm','/api/master-data/parts');
</script>
