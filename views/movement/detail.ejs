<div class="d-flex justify-content-between align-items-center mb-4 no-print"><div><h4 class="mb-1"><%= ticket.ticketNumber %></h4><p class="text-muted mb-0">Movement memo details</p></div><div class="d-flex gap-2"><a href="/movement-tickets" class="btn btn-light">Back</a><button onclick="window.print()" class="btn btn-primary"><i class="ri-printer-line me-1"></i>Print memo</button></div></div>
<div class="card"><div class="card-body p-4">
<div class="text-center mb-4"><h3 class="mb-1">AUTOLINE INDUSTRIES LTD.</h3><h5> MOVEMENT TICKET</h5><div class="text-muted">Dispatch / Movement Memo</div></div>
<div class="row g-3 mb-4"><div class="col-6"><strong>Ticket No:</strong> <%= ticket.ticketNumber %></div><div class="col-6 text-end"><strong>Date:</strong> <%= new Date(ticket.ticketDate).toLocaleDateString('en-IN') %></div><div class="col-6"><strong>Vehicle No:</strong> <%= ticket.vehicleNumber %></div><div class="col-6"><strong>Plant:</strong> <%= ticket.plant?.name || ticket.plant?.code || '—' %></div><div class="col-6"><strong>Sales Order:</strong> <%= ticket.salesOrder || '—' %></div><div class="col-6"><strong>Vendor / Transport / Vehicle type:</strong> <%= ticket.vendorType || '—' %> / <%= ticket.transportMode || '—' %> / <%= ticket.vehicleType || '—' %></div><div class="col-6"><strong>Distance:</strong> <%= ticket.distanceKm || '—' %> km</div><div class="col-6"><strong>SAP Delivery:</strong> <%= ticket.sapDeliveryNumber || 'Pending SAP integration' %></div></div>
<div class="table-responsive"><table class="table table-bordered"><thead class="table-light"><tr><th>Sr.</th><th>Product Code</th><th>Part Name</th><th>Customer Reference</th><th>Sales Order</th><th>Sub M</th><th class="text-end">Qty</th><th>Unit</th></tr></thead><tbody><% ticket.items.forEach((i,n)=>{ %><tr><td><%= n+1 %></td><td><%= i.productCode %></td><td><%= i.partName %></td><td><%= i.customerReference || '—' %></td><td><%= i.salesOrder || '—' %></td><td><%= i.subM || '—' %></td><td class="text-end"><%= i.quantity %></td><td><%= i.unit %></td></tr><% }) %></tbody></table></div>
<div class="mt-4"><strong>Remarks:</strong> <%= ticket.notes || '—' %></div>
<div class="row mt-5 pt-4"><div class="col-4 text-center">____________________<br>Prepared By</div><div class="col-4 text-center">____________________<br>Approved By</div><div class="col-4 text-center">____________________<br>Driver / Receiver</div></div>
</div></div>
<div class="alert alert-info mt-3 no-print">This is the locally generated movement memo. SAP delivery and invoice processing are not yet enabled until the company's supported API arrangement and transaction mapping are confirmed.</div>
