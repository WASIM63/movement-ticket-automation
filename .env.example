PORT=9000
NODE_ENV=development
DATABASE_URL="mysql://movement_user:change_me@localhost:3306/movement_ticket"

# SAP Business Accelerator Hub sandbox only.
# Copy the personal API key from SAP Business Accelerator Hub > Show API Key.
# Never commit the real key; keep it only in your local .env / deployment secret store.
SAP_MODE=sandbox
SAP_SANDBOX_BASE_URL=https://sandbox.api.sap.com
SAP_SANDBOX_API_KEY=
# Copy the exact relative endpoint path from the selected API's sandbox code snippet.
# Example format only; do not use a guessed service path.
SAP_SANDBOX_SALES_ORDER_PATH=

# Production/company-tenant integration is intentionally not configured in this phase.
SAP_BASE_URL=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_COMMUNICATION_USER=
SAP_COMMUNICATION_PASSWORD=
SAP_OUTBOUND_DELIVERY_PATH=
SAP_BILLING_DOCUMENT_PATH=

MYSQL_DATABASE=movement_ticket
MYSQL_USER=movement_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
