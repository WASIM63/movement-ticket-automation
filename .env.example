PORT=9000
NODE_ENV=development
DATABASE_URL="mysql://movement_user:change_me@localhost:3306/movement_ticket"

# SAP Business Accelerator Hub sandbox ONLY.
SAP_MODE=sandbox
SAP_SANDBOX_BASE_URL=https://sandbox.api.sap.com
SAP_SANDBOX_API_KEY=

# SAP API Hub proxy prefix: /s4hanacloud
# These paths are relative to https://sandbox.api.sap.com.
# Override only if the API's current Hub Code Snippet specifies a different path.
SAP_SANDBOX_SALES_ORDER_PATH=/s4hanacloud/sap/opu/odata/sap/API_SALES_ORDER_SRV/A_SalesOrder
SAP_SANDBOX_SALES_ORDER_KEY_PATH=/s4hanacloud/sap/opu/odata/sap/API_SALES_ORDER_SRV/A_SalesOrder('{salesOrder}')

# Outbound Delivery (A2X), OData V2
SAP_SANDBOX_OUTBOUND_DELIVERY_PATH=/s4hanacloud/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=2/A_OutbDeliveryHeader
SAP_SANDBOX_CREATE_DELIVERY_PATH=/s4hanacloud/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=2/A_OutbDeliveryHeader
SAP_SANDBOX_UPDATE_DELIVERY_PATH=/s4hanacloud/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=2/A_OutbDeliveryHeader(DeliveryDocument='{DeliveryDocument}')
SAP_SANDBOX_UPDATE_PICKING_PATH=/s4hanacloud/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=2/SetPickingQuantityWithBaseQuantity?DeliveryDocument='{DeliveryDocument}'&DeliveryDocumentItem='{DeliveryDocumentItem}'&ActualDeliveredQtyInBaseUnit={ActualDeliveredQtyInBaseUnit}&BaseUnit='{BaseUnit}'
SAP_SANDBOX_POST_GOODS_ISSUE_PATH=/s4hanacloud/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=2/PostGoodsIssue?DeliveryDocument='{DeliveryDocument}'

# Billing Document - Create from SD Document (OData V4)
SAP_SANDBOX_BILLING_DOCUMENT_V4_PATH=/s4hanacloud/sap/opu/odata4/sap/api_billingdocument/srvd_a2x/sap/billingdocument/0001/BillingDocument
SAP_SANDBOX_CREATE_BILLING_PATH=/s4hanacloud/sap/opu/odata4/sap/api_billingdocument/srvd_a2x/sap/billingdocument/0001/BillingDocument/SAP__self.CreateFromSDDocument
SAP_SANDBOX_UPDATE_BILLING_PATH=/s4hanacloud/sap/opu/odata4/sap/api_billingdocument/srvd_a2x/sap/billingdocument/0001/BillingDocument('{BillingDocument}')

# Billing Document - Read, Cancel, GetPDF (OData V2)
SAP_SANDBOX_BILLING_DOCUMENT_V2_PATH=/s4hanacloud/sap/opu/odata/sap/API_BILLING_DOCUMENT_SRV/A_BillingDocument
SAP_SANDBOX_BILLING_PDF_PATH=/s4hanacloud/sap/opu/odata/sap/API_BILLING_DOCUMENT_SRV/Get%20PDF?BillingDocument='{billingDocument}'

# Generic SAP attachment service. GetAllOriginals also requires business-object type/key parameters.
SAP_SANDBOX_ATTACHMENT_PATH=/s4hanacloud/sap/opu/odata/sap/API_CV_ATTACHMENT_SRV/GetAllOriginals

# No generic released OData path has been confirmed for AutoLine's India eDocument Cockpit/e-way-bill update.
# Leave blank. SAP documents this process through India localization + SAP Integration Suite/GSP.
SAP_SANDBOX_ELECTRONIC_DOC_FILE_PATH=
SAP_SANDBOX_UPDATE_ELECTRONIC_DOC_PATH=

# Writes are fail-closed. Keep false until each exact operation is confirmed in Hub sandbox.
SAP_SANDBOX_ALLOW_WRITES=false

# Production credentials/tenant settings intentionally unused by this sandbox-only adapter.
# Do not point the sandbox client to the AutoLine production tenant.
SAP_BASE_URL=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_COMMUNICATION_USER=
SAP_COMMUNICATION_PASSWORD=
SAP_OUTBOUND_DELIVERY_PATH=
SAP_BILLING_DOCUMENT_PATH=

MYSQL_DATABASE=movement_ticket
MYSQL_USER=movement_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
