PORT=9000
NODE_ENV=development
DATABASE_URL="mysql://movement_user:change_me@localhost:3306/movement_ticket"

# SAP Business Accelerator Hub sandbox ONLY.
# Add your personal API key to your local .env file; never share or commit it.
SAP_MODE=sandbox
SAP_SANDBOX_BASE_URL=https://sandbox.api.sap.com
SAP_SANDBOX_API_KEY=

# Read API resource paths: copy the exact relative path from each API's own
# SAP Business Accelerator Hub sandbox code snippet. Do not guess these paths.
SAP_SANDBOX_SALES_ORDER_PATH=
SAP_SANDBOX_SALES_ORDER_KEY_PATH=
SAP_SANDBOX_OUTBOUND_DELIVERY_PATH=
SAP_SANDBOX_BILLING_DOCUMENT_V4_PATH=
SAP_SANDBOX_BILLING_DOCUMENT_V2_PATH=
SAP_SANDBOX_ELECTRONIC_DOC_FILE_PATH=
SAP_SANDBOX_ATTACHMENT_PATH=

# Write operation paths: configure only after confirming the exact sandbox
# operation, HTTP method and request schema in the official API specification.
SAP_SANDBOX_CREATE_DELIVERY_PATH=
SAP_SANDBOX_UPDATE_PICKING_PATH=
SAP_SANDBOX_UPDATE_DELIVERY_PATH=
SAP_SANDBOX_CREATE_BILLING_PATH=
SAP_SANDBOX_UPDATE_BILLING_PATH=
SAP_SANDBOX_UPDATE_ELECTRONIC_DOC_PATH=

# Fail-closed by default. Set true only for an API operation explicitly
# supported by the Hub sandbox and using sample data.
SAP_SANDBOX_ALLOW_WRITES=false

# Production/company tenant configuration is intentionally unused and disabled.
# Never point the sandbox client at the AutoLine production tenant.
SAP_BASE_URL=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_COMMUNICATION_USER=
SAP_COMMUNICATION_PASSWORD=
SAP_OUTBOUND_DELIVERY_PATH=
SAP_BILLING_DOCUMENT_PATH=

MYSQL_DATABASE=movement_ticket
MYSQL_USER=movement_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
