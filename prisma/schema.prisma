generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Plant {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(150)
  active    Boolean  @default(true)
  tickets   MovementTicket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id          Int      @id @default(autoincrement())
  registration String  @unique @db.VarChar(30)
  description String?  @db.VarChar(120)
  active      Boolean  @default(true)
  tickets     MovementTicket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Part {
  id                Int      @id @default(autoincrement())
  productCode       String   @unique @db.VarChar(80)
  partName          String   @db.VarChar(255)
  customerReference String?  @db.VarChar(80)
  salesOrder         String?  @db.VarChar(40)
  subM               String?  @db.VarChar(50)
  unit               String   @default("EA") @db.VarChar(10)
  active             Boolean  @default(true)
  ticketItems        MovementTicketItem[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MovementTicket {
  id                 Int      @id @default(autoincrement())
  ticketNumber       String   @unique @db.VarChar(40)
  ticketDate         DateTime
  plantId            Int?
  vehicleId          Int?
  vehicleNumber      String   @db.VarChar(30)
  salesOrder          String?  @db.VarChar(40)
  vendorType          String?  @db.VarChar(40)
  transportMode       String?  @db.VarChar(40)
  vehicleType         String?  @db.VarChar(40)
  distanceKm          Decimal? @db.Decimal(10,2)
  status              String   @default("DRAFT") @db.VarChar(30)
  sapDeliveryNumber   String?  @db.VarChar(40)
  sapBillingNumber    String?  @db.VarChar(40)
  sapMessage          String?  @db.Text
  notes               String?  @db.Text
  plant               Plant?   @relation(fields: [plantId], references: [id])
  vehicle             Vehicle? @relation(fields: [vehicleId], references: [id])
  items               MovementTicketItem[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([ticketDate])
  @@index([status])
}

model MovementTicketItem {
  id              Int      @id @default(autoincrement())
  ticketId        Int
  partId          Int?
  productCode     String   @db.VarChar(80)
  partName        String   @db.VarChar(255)
  customerReference String? @db.VarChar(80)
  salesOrder      String?  @db.VarChar(40)
  subM            String?  @db.VarChar(50)
  quantity        Decimal  @db.Decimal(12,3)
  unit            String   @default("EA") @db.VarChar(10)
  ticket          MovementTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  part            Part?    @relation(fields: [partId], references: [id])
  createdAt       DateTime @default(now())
  @@index([ticketId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  entityType  String   @db.VarChar(60)
  entityId    String   @db.VarChar(60)
  action      String   @db.VarChar(60)
  details     Json?
  createdAt   DateTime @default(now())
  @@index([entityType, entityId])
}
